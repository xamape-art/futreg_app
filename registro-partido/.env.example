# Copia este archivo a .env y rellena con los datos de tu proyecto Supabase
# (Supabase Studio > Project Settings > Data API / API Keys).
#
# La anon key esta pensada para viajar en el bundle del navegador: lo que
# protege los datos son las politicas RLS de supabase/schema.sql, no el secreto
# de esta clave. Nunca pongas aqui la service_role key.
#
# Si estas variables faltan, la app arranca en modo local (localStorage, sin
# login), que es como funcionaba antes de conectar la nube.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
